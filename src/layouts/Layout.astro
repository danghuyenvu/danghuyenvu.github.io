---
import "../index.css";
import "highlight.js/styles/atom-one-dark.css";
import ProfileCard from "../components/ProfileCard.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string; // absolute URL, used for link previews
}

const {
  title = "lab-writeups",
  description = "Notes and reports from labs and exercises.",
  image,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- link previews (Discord, LinkedIn, Slack, ...) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />

    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>

  <body>
    <div class="flex min-h-screen flex-col">
      <header class="border-b border-line">
        <div class="mx-auto flex max-w-[70rem] items-baseline justify-between px-6 py-6">
          <a href={`${base}/`} class="font-mono text-sm tracking-tight text-ink">
            lab-writeups<span class="text-accent">.</span>
          </a>

          <nav class="flex gap-5 font-mono text-xs text-ink-soft">
            <a
              href="https://github.com/danghuyenvu"
              target="_blank"
              rel="noreferrer"
              class="transition-colors hover:text-accent"
            >
              github
            </a>
          </nav>
        </div>
      </header>

      <div class="mx-auto flex w-full max-w-[70rem] flex-1 gap-10 px-6 py-10">
        <!-- Left sidebar: hidden below the lg breakpoint (phones, small tablets).
             Pages can fill it with <Something slot="sidebar" />; the default is the profile card. -->
        <aside class="hidden w-64 shrink-0 lg:block" aria-label="Sidebar">
          <div class="sticky top-8">
            <slot name="sidebar">
              <ProfileCard />
            </slot>
          </div>
        </aside>

        <main class="min-w-0 max-w-3xl flex-1">
          <slot />
        </main>
      </div>

      <footer class="mt-16 border-t border-line">
        <div class="mx-auto max-w-[70rem] px-6 py-6 font-mono text-xs text-ink-soft">
          Built with Astro. Source on GitHub.
        </div>
      </footer>
    </div>
  </body>
</html>