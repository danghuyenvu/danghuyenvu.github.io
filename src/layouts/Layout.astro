
---
import "../index.css";

interface Props {
  title?: string;
}

const { title = "lab-writeups" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link
      rel="icon"
      type="image/x-icon"
      href={`${import.meta.env.BASE_URL}favicon.svg`}
    />
  </head>

  <body>
    <div class="min-h-screen flex flex-col">
      <header class="border-b border-[var(--color-line)]">
        <div class="max-w-3xl mx-auto px-6 py-6 flex items-baseline justify-between">
          <a
            href={import.meta.env.BASE_URL}
            class="font-mono text-sm tracking-tight text-[var(--color-ink)]"
          >
            lab-writeups<span class="text-[var(--color-accent)]">.</span>
          </a>

          <nav class="font-mono text-xs text-[var(--color-ink-soft)] flex gap-5">
            <a
              href="https://github.com/danghuyenvu"
              target="_blank"
              rel="noreferrer"
              class="hover:text-[var(--color-accent)] transition-colors"
            >
              github
            </a>
          </nav>
        </div>
      </header>

      <main class="flex-1 max-w-3xl mx-auto w-full px-6 py-10">
        <slot />
      </main>

      <footer class="border-t border-[var(--color-line)] mt-16">
        <div class="max-w-3xl mx-auto px-6 py-6 font-mono text-xs text-[var(--color-ink-soft)]">
          Built with Astro. Source on GitHub.
        </div>
      </footer>
    </div>
  </body>
</html>
